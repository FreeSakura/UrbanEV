{
  "version": "paris_teacher_models_v1.0",
  "data_role": "development_only",
  "target": "non-available-port rate",
  "lookback": 168,
  "horizons": [3, 6, 9, 12],
  "seed": 42,
  "external_scaler": "per_station_zscore_train_observed_only",
  "missing_fill": "causal_ffill_4h_then_train_station_hour_of_week_median_then_train_station_median",
  "target_mask_usage": ["training_loss", "validation_selection", "evaluation_metric"],
  "target_mask_is_model_input": false,
  "prediction_clip": [0.0, 1.0],
  "time_xer": {
    "identity": "TimeXer_local_audited_compact_L168",
    "source": "work/UrbanEV-reproduction/audited/code-transformer/models/TimeXer.py::Model",
    "source_status": "local_audited_adaptation_not_exact_upstream_official",
    "upstream_reference": "https://github.com/thuml/Time-Series-Library",
    "upstream_commit": "NOT_DISCLOSED_IN_LOCAL_URBANE_V_RELEASE",
    "profile": "compact",
    "d_model": 128,
    "n_heads": 4,
    "e_layers": 2,
    "d_ff": 512,
    "dropout": 0.1,
    "patch_len": 12,
    "features": "M",
    "use_norm": 1,
    "objective": "direct_endpoint",
    "pred_len": 1,
    "time_markers": "none",
    "epochs": 50,
    "patience": 8,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "gradient_clip": 1.0
  },
  "paris_caper": {
    "variant": "Paris_CAPER_phase_only",
    "history_encoder_hidden": 64,
    "station_embedding_dim": 8,
    "phase_hidden": 32,
    "dropout": 0.1,
    "epochs": 100,
    "patience": 12,
    "batch_size": 32,
    "learning_rate": 0.001,
    "weight_decay": 0.00001,
    "gradient_clip": 1.0,
    "state_mapping": {
      "available": "Available / total ports",
      "active": "Charging / total ports",
      "unavailable": "(Passive + Other) / total ports",
      "target": "active + unavailable"
    },
    "phase_lags_ordinal_hours": [24, 168],
    "urban_ev_checkpoint_loading": false,
    "urban_ev_coefficient_loading": false
  },
  "queue": {
    "single_gpu": true,
    "max_parallel": 1,
    "max_attempts": 2,
    "retry_policy": "same_config_technical_failure_only"
  },
  "aggregation": {
    "alpha": "one_global_scalar_per_fold_pooled_over_four_horizons",
    "fold_1_fit_source": "paired_pre_evaluation_validation_predictions",
    "later_fold_fit_source": "paired_prior_fold_oof_predictions_only",
    "bootstrap_blocks_hours": 24,
    "bootstrap_replicates": 5000,
    "bootstrap_seed": 42,
    "bootstrap_time_rule": "within each fold intersect target timestamps across four horizons, sample common 24h blocks once and reuse the same sampled timestamps for all horizons",
    "bootstrap_reference_selection": "reselect lower-macro-RMSE CAPER/TimeXer single model inside every replicate"
  },
  "student_training_authorized": false,
  "formal_target_access": false,
  "protected_target_access": false
}
